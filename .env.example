# =================================================================
# TestQ Backend - Environment Configuration Example
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file with secrets to git!
# =================================================================

# Server Port
PORT=5000

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/testq
MONGO_USERNAME=
MONGO_PASSWORD=

# CORS Configuration
# Comma-separated allowed origins (e.g., https://testq.iqpaths.com,https://resume.iqpaths.com)
CORS_ALLOWED_ORIGINS=https://testq.iqpaths.com,https://resume.iqpaths.com,https://test-q-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Frontend URL
FRONTEND_URL=https://testq.iqpaths.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Configuration
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=

# Mailer / Brevo Configuration
MAIL_HOST=smtp.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TestQ

# Razorpay Configuration
RAZORPAY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI & Gemini API
GEMINI_API_KEY=
AI_INTERVIEW_TTS_ENABLED=true

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
